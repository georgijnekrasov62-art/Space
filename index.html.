<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>ProClub — Киберспортивный клуб нового поколения</title>
<!-- Шрифты Orbitron и Rajdhani используются в CSS, но не были подключены — исправлено -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@700;800;900&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet" />
<style>
  /* ============ ПЕРЕМЕННЫЕ ============ */
  :root {
    --bg-dark: #07071a;
    --bg-panel: #10102a;
    --bg-panel-2: #16163a;
    --blue: #00d4ff;
    --violet: #a855f7;
    --red: #ff2d6f;
    --text: #e4e4f0;
    --text-dim: #9a9ab8;
    --grad-main: linear-gradient(135deg, #00d4ff 0%, #a855f7 50%, #ff2d6f 100%);
    --grad-card: linear-gradient(145deg, rgba(168,85,247,.15), rgba(0,212,255,.05));
    --shadow-glow: 0 0 40px rgba(168, 85, 247, .35);
    --radius: 18px;
    --transition: .35s cubic-bezier(.2,.8,.2,1);
  }

  /* ============ СБРОС ============ */
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; scroll-padding-top: 90px; }
  body {
    font-family: 'Rajdhani', 'Segoe UI', system-ui, sans-serif;
    background: var(--bg-dark);
    color: var(--text);
    line-height: 1.6;
    overflow-x: hidden;
    position: relative;
  }

  /* Анимированный фоновый градиент */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background:
      radial-gradient(circle at 15% 20%, rgba(0,212,255,.18), transparent 45%),
      radial-gradient(circle at 85% 70%, rgba(255,45,111,.18), transparent 45%),
      radial-gradient(circle at 50% 50%, rgba(168,85,247,.12), transparent 60%);
    z-index: -2;
    animation: bgShift 18s ease-in-out infinite alternate;
  }
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(168,85,247,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,212,255,.04) 1px, transparent 1px);
    background-size: 50px 50px;
    z-index: -1;
    pointer-events: none;
  }
  @keyframes bgShift {
    0%   { transform: translate(0,0) scale(1); }
    100% { transform: translate(-30px,20px) scale(1.05); }
  }

  /* ============ КОНТЕЙНЕР ============ */
  .container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* ============ ШАПКА ============ */
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    background: rgba(7,7,26,.7);
    border-bottom: 1px solid rgba(168,85,247,.15);
    transition: var(--transition);
  }
  header.scrolled {
    background: rgba(7,7,26,.92);
    box-shadow: 0 4px 30px rgba(0,0,0,.5);
  }
  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 0;
  }
  .logo {
    font-family: 'Orbitron', sans-serif;
    font-size: 26px;
    font-weight: 900;
    letter-spacing: 2px;
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .logo::before {
    content: '';
    width: 12px; height: 12px;
    background: var(--grad-main);
    border-radius: 3px;
    box-shadow: 0 0 14px var(--violet);
    transform: rotate(45deg);
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  .nav-links a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    letter-spacing: .5px;
    text-transform: uppercase;
    position: relative;
    transition: var(--transition);
  }
  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0; bottom: -6px;
    width: 0; height: 2px;
    background: var(--grad-main);
    transition: width var(--transition);
  }
  .nav-links a:hover { color: var(--blue); }
  .nav-links a:hover::after { width: 100%; }

  .burger {
    display: none;
    flex-direction: column;
    gap: 5px;
    cursor: pointer;
    background: none;
    border: none;
    padding: 8px;
  }
  .burger span {
    width: 26px; height: 3px;
    background: var(--text);
    border-radius: 2px;
    transition: var(--transition);
  }
  .burger.active span:nth-child(1) { transform: translateY(8px) rotate(45deg); }
  .burger.active span:nth-child(2) { opacity: 0; }
  .burger.active span:nth-child(3) { transform: translateY(-8px) rotate(-45deg); }

  /* ============ HERO ============ */
  .hero {
    min-height: 100vh;
    min-height: 100svh; /* корректный 100vh на мобильных с адресной строкой */
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 120px 24px 60px;
    position: relative;
  }
  .hero-content { max-width: 900px; }
  .hero-badge {
    display: inline-block;
    padding: 8px 20px;
    border: 1px solid rgba(0,212,255,.4);
    border-radius: 50px;
    font-size: 13px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--blue);
    margin-bottom: 28px;
    background: rgba(0,212,255,.05);
    animation: fadeUp .8s ease both;
  }
  .hero h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(38px, 7vw, 82px);
    font-weight: 900;
    line-height: 1.05;
    letter-spacing: -1px;
    margin-bottom: 24px;
    animation: fadeUp .9s .1s ease both;
  }
  .hero h1 .gradient {
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    display: inline-block;
  }
  .hero p {
    font-size: clamp(16px, 2vw, 20px);
    color: var(--text-dim);
    margin-bottom: 40px;
    max-width: 640px;
    margin-left: auto;
    margin-right: auto;
    animation: fadeUp 1s .2s ease both;
  }
  .hero-buttons {
    display: flex;
    gap: 18px;
    justify-content: center;
    flex-wrap: wrap;
    animation: fadeUp 1.1s .3s ease both;
  }

  /* Кнопки */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 34px;
    border-radius: 50px;
    font-family: 'Rajdhani', sans-serif;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    border: none;
    transition: var(--transition);
    position: relative;
    overflow: hidden;
  }
  .btn-primary {
    background: var(--grad-main);
    color: #fff;
    box-shadow: 0 8px 30px rgba(168,85,247,.4);
  }
  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 14px 40px rgba(255,45,111,.55);
  }
  .btn-primary::before {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 100%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.3), transparent);
    transition: left .6s;
  }
  .btn-primary:hover::before { left: 100%; }
  .btn-outline {
    background: transparent;
    color: var(--text);
    border: 2px solid rgba(168,85,247,.5);
  }
  .btn-outline:hover {
    border-color: var(--blue);
    color: var(--blue);
    transform: translateY(-3px);
    box-shadow: 0 8px 30px rgba(0,212,255,.25);
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ============ СЕКЦИИ ============ */
  section { padding: 100px 0; position: relative; }
  .section-head { text-align: center; margin-bottom: 60px; }
  .section-tag {
    display: inline-block;
    color: var(--blue);
    font-size: 14px;
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 14px;
    font-weight: 700;
  }
  .section-head h2 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(30px, 5vw, 48px);
    font-weight: 800;
    letter-spacing: -1px;
    line-height: 1.1;
  }
  .section-head h2 .gradient {
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .section-head p {
    color: var(--text-dim);
    max-width: 620px;
    margin: 18px auto 0;
    font-size: 17px;
  }

  /* ============ О КОМПАНИИ ============ */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }
  .about-text h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 28px;
    margin-bottom: 20px;
    color: var(--blue);
  }
  .about-text p {
    color: var(--text-dim);
    margin-bottom: 18px;
    font-size: 16px;
  }
  .about-stats {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
    margin-top: 32px;
  }
  .stat {
    padding: 22px;
    background: var(--grad-card);
    border: 1px solid rgba(168,85,247,.2);
    border-radius: var(--radius);
    transition: var(--transition);
  }
  .stat:hover {
    transform: translateY(-4px);
    border-color: var(--blue);
    box-shadow: var(--shadow-glow);
  }
  .stat-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 36px;
    font-weight: 900;
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .stat-label {
    font-size: 14px;
    color: var(--text-dim);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .about-visual {
    position: relative;
    aspect-ratio: 1/1;
    border-radius: 30px;
    background: var(--grad-card);
    border: 1px solid rgba(168,85,247,.25);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .about-visual::before {
    content: '';
    position: absolute;
    inset: -2px;
    background: var(--grad-main);
    border-radius: 30px;
    opacity: .4;
    filter: blur(40px);
    z-index: 0;
  }
  .about-visual-inner {
    position: relative;
    z-index: 1;
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(60px, 10vw, 140px);
    font-weight: 900;
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -4px;
  }

  /* ============ ТАРИФЫ ============ */
  .pricing-grid {
    display: grid;
    /* min-width 320px даёт ровно 3 колонки в строке при ширине контейнера 1240px */
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 24px;
  }
  .price-card {
    position: relative;
    padding: 34px 28px;
    background: var(--bg-panel);
    border: 1px solid rgba(168,85,247,.18);
    border-radius: var(--radius);
    transition: var(--transition);
    overflow: hidden;
  }
  .price-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--grad-main);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--transition);
  }
  .price-card:hover {
    transform: translateY(-8px);
    border-color: var(--violet);
    box-shadow: var(--shadow-glow);
  }
  .price-card:hover::before { transform: scaleX(1); }
  .price-card.featured {
    border-color: var(--red);
    background: linear-gradient(145deg, rgba(255,45,111,.1), rgba(168,85,247,.05));
  }
  .price-card.featured::before { transform: scaleX(1); }
  .price-badge {
    position: absolute;
    top: 18px; right: 18px;
    background: var(--red);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    padding: 5px 12px;
    border-radius: 50px;
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .price-icon {
    width: 54px; height: 54px;
    border-radius: 14px;
    background: var(--grad-main);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    margin-bottom: 20px;
    box-shadow: 0 6px 20px rgba(168,85,247,.4);
  }
  .price-card h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 22px;
    margin-bottom: 8px;
  }
  .price-card .time {
    color: var(--text-dim);
    font-size: 14px;
    margin-bottom: 20px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  .price-amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 22px;
    padding-bottom: 22px;
    border-bottom: 1px solid rgba(168,85,247,.15);
  }
  .price-amount .num {
    font-family: 'Orbitron', sans-serif;
    font-size: 42px;
    font-weight: 900;
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .price-amount .cur {
    font-size: 18px;
    color: var(--text-dim);
  }
  .price-features {
    list-style: none;
    margin-bottom: 26px;
  }
  .price-features li {
    padding: 8px 0;
    color: var(--text-dim);
    font-size: 15px;
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .price-features li::before {
    content: '✓';
    color: var(--blue);
    font-weight: 900;
  }
  .price-card .btn {
    width: 100%;
    justify-content: center;
    padding: 12px 20px;
    font-size: 14px;
  }

  /* ============ АКЦИИ ============ */
  .promos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 26px;
  }
  .promo-card {
    position: relative;
    padding: 36px 30px;
    border-radius: var(--radius);
    overflow: hidden;
    transition: var(--transition);
    min-height: 280px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    color: #fff;
    cursor: pointer;
  }
  .promo-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    transition: transform .6s ease;
  }
  .promo-card:hover::before { transform: scale(1.08); }
  .promo-card:hover { transform: translateY(-6px); box-shadow: 0 20px 50px rgba(0,0,0,.5); }

  .promo-1::before { background: linear-gradient(135deg, #00d4ff, #a855f7); }
  .promo-2::before { background: linear-gradient(135deg, #a855f7, #ff2d6f); }
  .promo-3::before { background: linear-gradient(135deg, #ff2d6f, #00d4ff); }

  .promo-card > * { position: relative; z-index: 1; }
  .promo-tag {
    display: inline-block;
    background: rgba(0,0,0,.35);
    backdrop-filter: blur(10px);
    padding: 6px 14px;
    border-radius: 50px;
    font-size: 12px;
    letter-spacing: 2px;
    text-transform: uppercase;
    font-weight: 700;
    margin-bottom: 16px;
    align-self: flex-start;
  }
  .promo-card h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 26px;
    margin-bottom: 12px;
    line-height: 1.15;
  }
  .promo-card p {
    font-size: 15px;
    opacity: .92;
    margin-bottom: 18px;
  }
  .promo-link {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-size: 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: var(--transition);
  }
  .promo-link:hover { gap: 14px; }

  /* ============ БОНУСНАЯ ПРОГРАММА ============ */
  .loyalty {
    background: linear-gradient(180deg, transparent, rgba(168,85,247,.04), transparent);
  }
  .loyalty-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 24px;
    margin-bottom: 50px;
  }
  .loyalty-card {
    padding: 30px 26px;
    background: var(--bg-panel);
    border: 1px solid rgba(0,212,255,.15);
    border-radius: var(--radius);
    text-align: center;
    transition: var(--transition);
    position: relative;
  }
  .loyalty-card:hover {
    transform: translateY(-6px) scale(1.02);
    border-color: var(--blue);
    box-shadow: 0 10px 40px rgba(0,212,255,.2);
  }
  .loyalty-num {
    font-family: 'Orbitron', sans-serif;
    font-size: 48px;
    font-weight: 900;
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    margin-bottom: 10px;
  }
  .loyalty-card h4 {
    font-family: 'Orbitron', sans-serif;
    font-size: 18px;
    margin-bottom: 12px;
  }
  .loyalty-card p {
    color: var(--text-dim);
    font-size: 14px;
  }
  .loyalty-info {
    padding: 34px;
    background: var(--grad-card);
    border: 1px solid rgba(168,85,247,.25);
    border-radius: var(--radius);
    text-align: center;
  }
  .loyalty-info h3 {
    font-family: 'Orbitron', sans-serif;
    font-size: 24px;
    margin-bottom: 14px;
    background: var(--grad-main);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .loyalty-info p { color: var(--text-dim); max-width: 720px; margin: 0 auto; }

  /* ============ КОНТАКТЫ ============ */
  .contacts-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: stretch;
  }
  .contact-info {
    padding: 40px;
    background: var(--bg-panel);
    border: 1px solid rgba(168,85,247,.2);
    border-radius: var(--radius);
  }
  .contact-item {
    display: flex;
    gap: 18px;
    padding: 20px 0;
    border-bottom: 1px solid rgba(168,85,247,.1);
  }
  .contact-item:last-child { border-bottom: none; }
  .contact-icon {
    flex-shrink: 0;
    width: 48px; height: 48px;
    border-radius: 12px;
    background: var(--grad-main);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    box-shadow: 0 6px 20px rgba(168,85,247,.3);
  }
  .contact-item h4 {
    font-family: 'Orbitron', sans-serif;
    font-size: 14px;
    color: var(--blue);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 6px;
  }
  .contact-item p { color: var(--text); font-size: 16px; }
  .contact-item a { color: var(--text); text-decoration: none; transition: var(--transition); }
  .contact-item a:hover { color: var(--blue); }

  .map-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(168,85,247,.25);
    min-height: 400px;
    position: relative;
    background: var(--bg-panel);
  }
  .map-wrap iframe {
    width: 100%;
    height: 100%;
    min-height: 400px;
    border: 0;
    filter: invert(.9) hue-rotate(180deg) saturate(.6);
  }

  /* ============ ФУТЕР ============ */
  footer {
    padding: 40px 0 30px;
    border-top: 1px solid rgba(168,85,247,.15);
    text-align: center;
    color: var(--text-dim);
    font-size: 14px;
  }
  .socials {
    display: flex;
    gap: 14px;
    justify-content: center;
    margin-bottom: 20px;
  }
  .socials a {
    width: 42px; height: 42px;
    border-radius: 50%;
    background: var(--bg-panel);
    border: 1px solid rgba(168,85,247,.2);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text);
    text-decoration: none;
    transition: var(--transition);
    font-size: 16px;
  }
  .socials a:hover {
    background: var(--grad-main);
    border-color: transparent;
    transform: translateY(-3px);
    box-shadow: 0 8px 20px rgba(168,85,247,.4);
  }

  /* ============ АНИМАЦИИ ПОЯВЛЕНИЯ ============ */
  .reveal {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity .8s ease, transform .8s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ============ АДАПТИВ ============ */
  @media (max-width: 900px) {
    /* навигация сжимается между 768–900px, иначе пункты переполняют шапку */
    .nav-links { gap: 18px; }
    .nav-links a { font-size: 13px; letter-spacing: .3px; }
    .about-grid, .contacts-grid { grid-template-columns: 1fr; }
    .about-visual { max-width: 400px; margin: 0 auto; }
  }
  @media (max-width: 768px) {
    section { padding: 70px 0; }
    .nav-links {
      position: fixed;
      top: 78px; left: 0; right: 0; /* реальная высота шапки ~78px, было 70px — меню перекрывало контент */
      flex-direction: column;
      gap: 0;
      background: rgba(7,7,26,.98);
      backdrop-filter: blur(14px);
      padding: 20px 0;
      transform: translateY(-150%);
      transition: transform var(--transition);
